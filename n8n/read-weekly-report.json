      "id": "8106d8f7-6153-48c1-8204-2909a7d21a4d",
      "name": "List saved weeks",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Все сохранённые недели репозитория: { reports: [{ weekStart, totals }] }, новые сверху.\n// Пустой item (строк нет, alwaysOutputData) и битый stats_json пропускаются, а не роняют ответ.\nconst reports = [];\nfor (const { json: row } of $input.all()) {\n  if (!row.week_start || !row.stats_json) continue;\n  try {\n    const stats = JSON.parse(row.stats_json);\n    if (stats?.totals) reports.push({ weekStart: row.week_start, totals: stats.totals });\n  } catch (error) {\n    // Строка с повреждённым stats_json не должна скрывать остальные недели.\n  }\n}\nreports.sort((a, b) => b.weekStart.localeCompare(a.weekStart));\nreturn [{ json: { repository: 'tarasxryak/cs-math', reports: reports.slice(0, 104) } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        360
      ],
      "id": "776d95e8-ac4a-4433-bb11-f3f60bcc325e",
