        "dataTableId": {
          "__rl": true,
          "value": "={{ $('Open weekly stats table').first().json.id }}",
          "mode": "id"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "repository",
              "condition": "eq",
              "keyValue": "={{ $('Validate weekStart').first().json.repository }}"
            },
            {
              "keyName": "week_start",
              "condition": "eq",
              "keyValue": "={{ $('Validate weekStart').first().json.weekStart }}"
            }
          ]
        },
        "returnAll": false,
        "limit": 1
      },
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        900,
        -100
      ],
      "id": "947c4892-0246-403d-a5af-3fb8816d0167",
      "name": "Find saved week",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const { repository, weekStart } = $('Validate weekStart').first().json;\n// «Find saved week» выдаёт пустой item, если строки нет (alwaysOutputData).\nconst row = $input.first()?.json ?? {};\nif (!row.stats_json) {\n  return [{ json: { report: null } }];\n}\n\nlet stats;\ntry {\n  stats = JSON.parse(row.stats_json);\n} catch (error) {\n  throw new Error('stats_json за ' + weekStart + ' не является JSON: ' + error.message);\n}\n\nreturn [{\n  json: {\n    report: {\n      repository: row.repository ?? repository,\n      weekStart: row.week_start ?? weekStart,\n      totals: stats.totals,\n      byType: stats.byType,\n      byAuthor: stats.byAuthor ?? [],\n    },\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        -100
      ],
      "id": "b68f90b7-324e-4e7a-9da6-55a530b03188",
      "name": "Build report"
    },
