# Production URL of the n8n «Read weekly report» webhook (Webhook node → Production URL).
# Server-side only: no NEXT_PUBLIC_ prefix, so it never reaches the browser.
N8N_WEBHOOK_URL=https://your-n8n.example.com/webhook/lab8-weekly-report

# Optional. Set only if the Webhook node uses Header Auth (name: Authorization, value: Bearer <token>).
N8N_WEBHOOK_TOKEN=

# Optional. The history webhook URL; by default the last path segment of N8N_WEBHOOK_URL
# is replaced with lab8-weekly-history.
N8N_HISTORY_WEBHOOK_URL=
